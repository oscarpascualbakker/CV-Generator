#!/usr/bin/env python3
# Barrera contra la publicacion de datos personales.
#
# Bloquea el commit si:
#   1. Se intenta versionar un fichero privado (aunque se fuerce con `git add -f`),
#      en cualquiera de los dos idiomas (CARRERA-EVIDENCIAS.md / CAREER-EVIDENCE.md...).
#   2. Algun fichero del commit contiene los datos de identidad de la seccion 1 del
#      banco (nombre, telefono, email, LinkedIn, GitHub).
#
# La lista de ficheros privados y la lectura del banco viven en tools/cvcheck/bank.py,
# compartidas con el validador.
#
# Se activa una vez por clon:  git config core.hooksPath .githooks
# Saltarselo (git commit --no-verify) es posible, pero deliberado.
import fnmatch
import os
import subprocess
import sys

MESSAGES = {
    "es": {
        "private": "fichero privado: {p}",
        "personal": "dato personal en {p}: {v}",
        "blocked": "pre-commit: commit bloqueado para no publicar datos personales.\n",
        "fix": "\nQuita esos ficheros o datos del commit (git restore --staged <fichero>).",
    },
    "en": {
        "private": "private file: {p}",
        "personal": "personal data in {p}: {v}",
        "blocked": "pre-commit: commit blocked to avoid publishing personal data.\n",
        "fix": "\nRemove those files or data from the commit (git restore --staged <file>).",
    },
}


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True).stdout


def main():
    root = git("rev-parse", "--show-toplevel").strip()
    sys.path.insert(0, os.path.join(root, "tools"))
    from cvcheck import bank

    # Los datos a proteger salen de los bancos reales que existan. Si no hay banco,
    # no hay datos que proteger, pero los ficheros privados se siguen bloqueando.
    values, lang = [], "en"
    for code in ("en", "es"):
        path = os.path.join(root, bank.BANK_NAMES[code])
        if os.path.exists(path):
            text = open(path, encoding="utf-8").read()
            values += bank.identity_values(text)
            lang = bank.bank_lang(text, path)
    msg = MESSAGES[lang]

    staged = [p for p in git("diff", "--cached", "--name-only", "--diff-filter=ACMR", "-z").split("\0") if p]
    problems = []

    for p in staged:
        if any(fnmatch.fnmatch(p, pat) for pat in bank.PRIVATE_PATTERNS):
            problems.append(msg["private"].format(p=p))

    for p in staged:
        try:
            content = git("show", f":{p}")
        except (subprocess.CalledProcessError, UnicodeDecodeError):
            continue
        low = content.lower()
        for v in values:
            if v.lower() in low:
                problems.append(msg["personal"].format(p=p, v=v))

    if problems:
        print(msg["blocked"], file=sys.stderr)
        for pr in problems:
            print(f"  - {pr}", file=sys.stderr)
        print(msg["fix"], file=sys.stderr)
        sys.exit(1)


main()
